# Mise web — optional overrides. Copy to .env.local to change defaults.
# All values below already default to the local stack, so `pnpm dev` works with
# no .env.local at all.

# AI service base URL
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (auth). The anon key is public (RLS-protected) — safe to commit.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
