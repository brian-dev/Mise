# Mise AI service — copy to .env and fill in. .env is gitignored.

# Anthropic API key (required for generation; the live test needs it non-empty).
ANTHROPIC_API_KEY=

# Optional model overrides (defaults in config.py, per docs/AI_LAYER.md §10).
# MEAL_PLAN_MODEL=claude-sonnet-4-6
# RECIPE_MODEL=claude-haiku-4-5

# Paid-tier pricing (optional). With a Spoonacular key, the shopping-list price
# fallback uses real-retail Spoonacular costs first and the AI estimate only for
# misses. Empty = free tier (AI estimate only). Free dev key: spoonacular.com/food-api
# SPOONACULAR_API_KEY=
